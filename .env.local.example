# Copy this to .env.local (which is gitignored).
#
# For teammates running the app locally:
# Just set NEXT_PUBLIC_CONVEX_URL to the shared backend URL.
# That's enough — auth, queries and mutations will all work.

NEXT_PUBLIC_CONVEX_URL=https://neat-iguana-318.convex.cloud

# Hyperspell — get a key at https://app.hyperspell.com/api-keys
# (For the hackathon, ping Rob in the team channel for the shared dev key.)
HYPERSPELL_API_KEY=hs-0-xxxxxxxxxxxxxxxxxxxxxx

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# --- Maintainers only (do not share) ---
# CONVEX_DEPLOY_KEY=...   # only the person pushing schema/functions needs this
# CONVEX_DEPLOYMENT=...   # only needed when running `npx convex dev`
